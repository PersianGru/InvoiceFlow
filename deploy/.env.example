# InvoiceFlow deployment variables (.env). Portainer: paste this file into the stack's environment
# variables (advanced mode). Docker Compose CLI: keep it as .env next to docker-compose.yml.
# Never commit a filled-in copy; the secrets belong in your secret manager.
# Everything else (users, firms, mail, mailboxes, domains, bots, AI engines, backups, cloud opt-in,
# connectors, SSO, API keys, webhooks, license activation) lives in the dashboard, not here. Tuning variables with built-in defaults are
# listed in deploy/README.md ("Advanced variables") and can be added to this file when needed.

# ---- required -------------------------------------------------------------------------------------
# generate each: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
SECRET_KEY=
MASTER_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# the public https URL users open (the web container proxies /api to the API)
PUBLIC_URL=https://invoiceflow.example.com

# ---- host -----------------------------------------------------------------------------------------
# the product image is pulled from ghcr.io/persiangru/invoiceflow:<INVOICEFLOW_VERSION>; set IMAGE only to
# use an image you built yourself
INVOICEFLOW_VERSION=0.11.1
# IMAGE=invoiceflow:0.11.1
WEB_PORT=3000
# path of the host's machine-id file (sealed installation ids); on a host without one, create a file
# with 32 random hex characters once and point to it
MACHINE_ID_PATH=/etc/machine-id
# true requires https in front of the web container (reverse proxy); false only for an http test
COOKIE_SECURE=true
# limits of the backup container: a large backup never slows the dashboard down
BACKUP_CPUS=1.0
BACKUP_MEMORY=1g

# ---- built-in reading model (CPU, no GPU) ---------------------------------------------------------
# qwen2.5-1.5b (default, ~1.5 GB RAM) or qwen2.5-0.5b for small hosts
LLAMACPP_MODEL=qwen2.5-1.5b
# empty = all cores; set to leave cores for the API on small hosts
LLAMACPP_THREADS=

# ---- set in the dashboard, not here (0.11) -------------------------------------------------------
# Mail (SMTP), the inbound mailbox (IMAP), the platform domain and each firm's domain, Telegram bots,
# WhatsApp numbers, AI engines (own local model, cloud keys) and backup targets are set under
# Platform → Settings after the first-run setup, secrets stored encrypted. Upgrading from 0.10: the old
# variables (SMTP_*, IMAP_*, INBOUND_EMAIL_*, LOCAL_OPENAI_*, *_API_KEY, TELEGRAM_*, WHATSAPP_*) are
# imported once at the first start after the setup; delete them from this file afterwards.

# ---- optional: licensing overrides (the product's keys are built in; set only for a sandbox test) --
LICENSE_PUBLIC_KEYS=
LICENSE_INSTALLATION_KEY=

# ---- optional: S3/MinIO archive instead of the local volume ---------------------------------------
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
